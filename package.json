{
  "name": "forecast-lab",
  "version": "1.6.0",
  "private": true,
  "description": "Quantlabs Neurolab · Laboratorio de análisis, simulación y redes neuronales",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.electron.json && tsc --noEmit && vite build",
    "check": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "smoke": "node tests/smoke.cjs",
    "smoke:neural": "node tests/smoke-neural.cjs",
    "smoke:units": "node tests/smoke-units.cjs",
    "units": "npm run build && electron . --curriculum",
    "smoke:emulator": "node tests/smoke-emulator.cjs",
    "emulator": "npm run build && electron . --emulator",
    "smoke:guide": "node tests/smoke-guide.cjs",
    "smoke:cdcgan": "node tests/smoke-cdcgan.cjs",
    "smoke:infographics": "node tests/smoke-infographics.cjs",
    "test:profiles": "node tests/test-profiles.cjs",
    "smoke:profiles": "node tests/smoke-profiles.cjs"
  },
  "dependencies": {
    "katex": "^0.16.22",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.0",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.forecastlab.desktop",
    "productName": "Quantlabs Neurolab",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python",
        "filter": [
          "**/*.py",
          "requirements*.txt"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "directories": {
      "output": "release"
    }
  }
}
